    <script>
        const quizData = [
            // 1. Masalah Pokok Ekonomi (Kebutuhan, Alat pemuas, Kelangkaan, Biaya Peluang) [1-13]
            {
                category: "Masalah Pokok Ekonomi",
                question: "Seseorang membutuhkan makanan dan minuman saat lapar. Berdasarkan tingkat kepentingannya, makanan dan minuman termasuk jenis kebutuhan...",
                options: [
                    { text: "Kebutuhan Primer", isCorrect: true, rationale: "Kebutuhan primer adalah kebutuhan pokok yang wajib dipenuhi untuk mempertahankan kelangsungan hidup manusia, seperti makanan, pakaian, dan tempat tinggal." },
                    { text: "Kebutuhan Sekunder", isCorrect: false, rationale: "Kebutuhan sekunder dipenuhi setelah kebutuhan primer terpenuhi, contohnya hiburan atau peralatan rumah tangga." },
                    { text: "Kebutuhan Tersier", isCorrect: false, rationale: "Kebutuhan tersier adalah kebutuhan barang mewah untuk meningkatkan status sosial." },
                    { text: "Kebutuhan Jasmani", isCorrect: false, rationale: "Meskipun sifatnya jasmani, pengelompokan berdasarkan tingkat kepentingan adalah primer, sekunder, dan tersier." }
                ],
                hint: "Pikirkan tingkat prioritas paling utama dalam hidup manusia."
            },
            {
                category: "Masalah Pokok Ekonomi",
                question: "Pendidikan, rekreasi, dan konseling psikologi merupakan contoh kebutuhan yang dikelompokkan berdasarkan...",
                options: [
                    { text: "Waktu Pemenuhan", isCorrect: false, rationale: "Berdasarkan waktu pemenuhan, kebutuhan dibagi menjadi kebutuhan sekarang dan kebutuhan yang akan datang." },
                    { text: "Sifat Pemenuhan", isCorrect: true, rationale: "Berdasarkan sifatnya, kebutuhan dibagi menjadi kebutuhan jasmani (fisik) dan rohani (jiwa/mental seperti pendidikan dan rekreasi)." },
                    { text: "Subjek Yang Membutuhkan", isCorrect: false, rationale: "Berdasarkan subjeknya, kebutuhan dibagi menjadi kebutuhan individu dan kelompok/sosial." },
                    { text: "Tingkat Intensitas", isCorrect: false, rationale: "Berdasarkan intensitasnya, kebutuhan dibagi menjadi primer, sekunder, dan tersier." }
                ],
                hint: "Perhatikan apakah kebutuhan tersebut memenuhi fisik atau jiwa/rohani."
            },
            {
                category: "Masalah Pokok Ekonomi",
                question: "Obat-obatan bagi orang yang sedang sakit termasuk contoh kebutuhan jika dilihat dari aspek...",
                options: [
                    { text: "Kebutuhan Sekarang", isCorrect: true, rationale: "Kebutuhan sekarang adalah kebutuhan mendesak yang harus dipenuhi saat itu juga dan tidak dapat ditunda, seperti obat saat sakit." },
                    { text: "Kebutuhan Masa Depan", isCorrect: false, rationale: "Kebutuhan masa depan adalah kebutuhan yang dipersiapkan untuk esok hari, seperti tabungan." },
                    { text: "Kebutuhan Tersier", isCorrect: false, rationale: "Obat bukan merupakan barang mewah melainkan kebutuhan pokok untuk kesehatan." },
                    { text: "Kebutuhan Kelompok", isCorrect: false, rationale: "Penggunaan obat bersifat perorangan/individu." }
                ],
                hint: "Fokus pada waktu kapan obat tersebut harus diminum."
            },
            {
                category: "Masalah Pokok Ekonomi",
                question: "Barang komplementer adalah barang yang pemenuhannya saling melengkapi. Contoh pasangan barang komplementer adalah...",
                options: [
                    { text: "Beras Dan Jagung", isCorrect: false, rationale: "Beras dan jagung adalah barang substitusi (saling menggantikan)." },
                    { text: "Mobil Dan Bensin", isCorrect: true, rationale: "Mobil tidak dapat berfungsi tanpa adanya bensin, sehingga keduanya saling melengkapi (komplementer)." },
                    { text: "Pulpen Dan Pensil", isCorrect: false, rationale: "Pulpen dan pensil adalah barang substitusi untuk alat tulis." },
                    { text: "Kopi Dan Teh", isCorrect: false, rationale: "Kopi dan teh adalah barang substitusi sebagai minuman penghangat." }
                ],
                hint: "Cari dua barang yang harus digunakan bersama agar berfungsi maksimal."
            },
            {
                category: "Masalah Pokok Ekonomi",
                question: "Barang yang jumlahnya sangat melimpah sehingga dapat menimbulkan bencana jika terlalu banyak disebut barang...",
