                    { text: "Uang Sebesar Rp100.000", isCorrect: false, rationale: "Rp100.000 adalah biaya riil/biaya akuntansi yang dikeluarkan, bukan biaya peluang." },
                    { text: "Buku Pelajaran Sekolah", isCorrect: false, rationale: "Buku pelajaran adalah pilihan yang diambil Budi, bukan kesempatan yang hilang." },
                    { text: "Harga Buku Dan Bioskop", isCorrect: false, rationale: "Biaya peluang diukur dari manfaat yang dikorbankan
